CAPSULE_ENV=development
CAPSULE_LOG_LEVEL=INFO

# Local Docker infrastructure. Change these only when the host ports below are occupied.
CAPSULE_DATABASE_URL=postgresql+asyncpg://capsule:capsule@localhost:5432/capsule
CAPSULE_MILVUS_URI=http://localhost:19530
CAPSULE_MILVUS_TOKEN=
CAPSULE_MILVUS_COLLECTION=asset_embeddings_seed16_1024

CAPSULE_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# When uploaded query images must be read by Doubao, set this to a public
# S3/MinIO endpoint or tunnel. Keep it empty when only remote image URLs are used.
CAPSULE_OBJECT_STORAGE_PUBLIC_ENDPOINT=
CAPSULE_OBJECT_STORAGE_BUCKET=capsule
CAPSULE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
CAPSULE_OBJECT_STORAGE_SECRET_KEY=minioadmin
CAPSULE_OBJECT_STORAGE_REGION=us-east-1

# Browser file/folder imports are kept here so SourceFile storage_uri remains valid.
CAPSULE_IMPORT_ROOT=data/imports
CAPSULE_IMPORT_FILE_MAX_BYTES=2147483648
# Bump this value when parser behavior or media-generation output changes.
CAPSULE_ASSETIZATION_VERSION=assetization-v3

# Required for real understanding and search embedding requests.
CAPSULE_ARK_API_KEY=
CAPSULE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CAPSULE_UNDERSTANDING_MODEL=doubao-seed-2-0-lite-260215
CAPSULE_EMBEDDING_MODEL=doubao-embedding-vision-250615
CAPSULE_EMBEDDING_DIMENSION=1024
CAPSULE_TOKENIZATION_BATCH_SIZE=64

CAPSULE_UNDERSTANDING_CONCURRENCY=32
CAPSULE_EMBEDDING_CONCURRENCY=64
CAPSULE_SEARCH_EMBEDDING_CONCURRENCY=16
CAPSULE_CAPSULE_CONCURRENCY=8
CAPSULE_FILE_PARSE_CONCURRENCY=4
CAPSULE_FFMPEG_CONCURRENCY=2
# Video visual segmentation (the MPS Worker runs on the macOS host, not in Docker).
CAPSULE_VIDEO_SCENE_THRESHOLD=27
CAPSULE_VIDEO_MIN_SCENE_SECONDS=1
CAPSULE_VIDEO_MAX_SHOT_SECONDS=45
CAPSULE_VIDEO_WINDOW_SECONDS=20
CAPSULE_VIDEO_SAMPLE_INTERVAL_SECONDS=5
CAPSULE_VIDEO_MAX_CANDIDATE_FRAMES=12
CAPSULE_VIDEO_MAX_REPRESENTATIVE_FRAMES=3
CAPSULE_MOBILECLIP_MODEL_PATH=data/models/mobileclip-s0/mobileclip_s0.pt
CAPSULE_MOBILECLIP_BATCH_SIZE=12
CAPSULE_MODEL_MAX_RETRIES=4
CAPSULE_UNDERSTANDING_TIMEOUT_SECONDS=180
CAPSULE_EMBEDDING_TIMEOUT_SECONDS=180
CAPSULE_MILVUS_BATCH_SIZE=100

CAPSULE_SEARCH_CHANNEL_TOP_K_MULTIPLIER=3
CAPSULE_SEARCH_CHANNEL_TOP_K_CAP=100
CAPSULE_SEARCH_CANDIDATE_CAP=300
CAPSULE_SEARCH_SAME_SOURCE_LIMIT=3
CAPSULE_SEARCH_RRF_K=60
CAPSULE_SEARCH_HNSW_EF=128
CAPSULE_SEARCH_ENGINE_VERSION=search-v1
CAPSULE_SEARCH_CAPSULE_RECENT_LIMIT=10
CAPSULE_QUERY_IMAGE_MAX_BYTES=20971520
CAPSULE_SEARCH_NATIVE_WEIGHT=1.0
CAPSULE_SEARCH_DESCRIPTION_WEIGHT=0.8
CAPSULE_SEARCH_SUBJECT_WEIGHT=0.8
CAPSULE_SEARCH_VISUAL_WEIGHT=0.6
CAPSULE_SEARCH_CORS_ORIGINS=["http://localhost:3000","https://capsule-search-workspace.ranhaoxu212.chatgpt.site"]
