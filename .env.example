CAPSULE_ENV=development
CAPSULE_LOG_LEVEL=INFO

# Local Docker infrastructure. Change these only when the host ports below are occupied.
CAPSULE_DATABASE_URL=postgresql+asyncpg://capsule:capsule@localhost:5432/capsule
CAPSULE_MILVUS_URI=http://localhost:19530
CAPSULE_MILVUS_TOKEN=
CAPSULE_MILVUS_COLLECTION=asset_embeddings_seed16_1024

CAPSULE_OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# When uploaded query images must be read by Doubao, set this to a public
# S3/MinIO endpoint or tunnel. Keep it empty when only remote image URLs are used.
CAPSULE_OBJECT_STORAGE_PUBLIC_ENDPOINT=
CAPSULE_OBJECT_STORAGE_BUCKET=capsule
CAPSULE_OBJECT_STORAGE_ACCESS_KEY=minioadmin
CAPSULE_OBJECT_STORAGE_SECRET_KEY=minioadmin
CAPSULE_OBJECT_STORAGE_REGION=us-east-1

# Browser file/folder imports are kept here so SourceFile storage_uri remains valid.
CAPSULE_IMPORT_ROOT=data/imports
CAPSULE_IMPORT_FILE_MAX_BYTES=2147483648
# Bump this value when parser behavior or media-generation output changes.
CAPSULE_ASSETIZATION_VERSION=assetization-v6

# Required for real understanding and search embedding requests.
CAPSULE_ARK_API_KEY=
CAPSULE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
CAPSULE_UNDERSTANDING_MODEL=doubao-seed-2-0-lite-260215
CAPSULE_SEARCH_PARSER_MODEL=doubao-seed-2-0-mini-260428
CAPSULE_EMBEDDING_MODEL=doubao-embedding-vision-250615
CAPSULE_EMBEDDING_DIMENSION=1024
# Document chunking uses the bundled DeepSeek V3 tokenizer locally.
# Set this only to override the packaged tokenizer.json.
# CAPSULE_DOCUMENT_TOKENIZER_PATH=/absolute/path/to/tokenizer.json
CAPSULE_TOKENIZATION_BATCH_SIZE=64
CAPSULE_DOCUMENT_CHUNK_MIN_TOKENS=250
CAPSULE_DOCUMENT_CHUNK_TARGET_TOKENS=400
CAPSULE_DOCUMENT_CHUNK_MAX_TOKENS=500
CAPSULE_DOCUMENT_CHUNK_MERGE_MAX_TOKENS=600
CAPSULE_DOCUMENT_PARENT_MAX_TOKENS=2000
CAPSULE_DOCUMENT_MEDIA_ROOT=data/document-media
CAPSULE_DOCUMENT_OCR_ENABLED=true
CAPSULE_DOCUMENT_OCR_MIN_CONFIDENCE=0.55
CAPSULE_DOCUMENT_OCR_MIN_EDGE=32
CAPSULE_DOCUMENT_OCR_MIN_AREA=4096

CAPSULE_UNDERSTANDING_CONCURRENCY=32
CAPSULE_ASSET_ENRICHMENT_QUEUE_SIZE=64
CAPSULE_SEARCH_UNDERSTANDING_CONCURRENCY=4
CAPSULE_NATIVE_EMBEDDING_CONCURRENCY=24
CAPSULE_VIDEO_NATIVE_EMBEDDING_CONCURRENCY=2
CAPSULE_EMBEDDING_CONCURRENCY=96
CAPSULE_SEARCH_EMBEDDING_CONCURRENCY=16
CAPSULE_CAPSULE_CONCURRENCY=8
CAPSULE_HTTP_MAX_CONNECTIONS=192
CAPSULE_HTTP_MAX_KEEPALIVE_CONNECTIONS=128
# Model-only derivatives keep originals untouched and are shared by Understanding/Embedding.
CAPSULE_MODEL_IMAGE_TARGET_BYTES=2097152
CAPSULE_MODEL_IMAGE_MAX_EDGE=1536
CAPSULE_MODEL_IMAGE_CACHE_ENTRIES=128
CAPSULE_FILE_PARSE_CONCURRENCY=4
CAPSULE_FFMPEG_CONCURRENCY=1
CAPSULE_VIDEO_UPLOAD_CONCURRENCY=4
CAPSULE_VIDEO_SPOOL_ROOT=data/video-spool
CAPSULE_VIDEO_SPOOL_MAX_ITEMS=32
CAPSULE_VIDEO_SPOOL_MAX_BYTES=4294967296
CAPSULE_VIDEO_UPLOAD_QUEUE_BACKEND=redis
CAPSULE_REDIS_URL=redis://localhost:6379/0
# Docker host port only; keep REDIS_URL in sync when this changes.
CAPSULE_REDIS_PORT=6379
CAPSULE_VIDEO_UPLOAD_STREAM=capsule:video-uploads
CAPSULE_VIDEO_UPLOAD_GROUP=capsule-video-uploaders
CAPSULE_VIDEO_UPLOAD_CLAIM_IDLE_MS=30000
CAPSULE_VIDEO_UPLOAD_MAX_ATTEMPTS=4
CAPSULE_VIDEO_UPLOAD_RETRY_BASE_SECONDS=0.5
# Video visual segmentation (the MPS Worker runs on the macOS host, not in Docker).
CAPSULE_VIDEO_SAMPLE_INTERVAL_SECONDS=0.5
CAPSULE_VIDEO_MIN_SEGMENT_SECONDS=1
CAPSULE_VIDEO_DISTANCE_QUANTILE=0.75
CAPSULE_VIDEO_MIN_DISTANCE_THRESHOLD=0.08
CAPSULE_VIDEO_MAX_DISTANCE_THRESHOLD=0.25
CAPSULE_VIDEO_SIMILARITY_RELAXATION=0.05
CAPSULE_VIDEO_MAX_MERGE_COST=0.5
CAPSULE_VIDEO_BASE_TARGET_SECONDS=10
CAPSULE_VIDEO_MAX_TARGET_SECONDS=20
CAPSULE_VIDEO_TARGET_LOG2_WEIGHT=0.15
CAPSULE_VIDEO_HARD_MAX_DURATION_FACTOR=1.5
CAPSULE_VIDEO_ACTIVITY_SAMPLE_FPS=6
CAPSULE_VIDEO_ACTIVITY_ENVELOPE_SECONDS=0.5
CAPSULE_VIDEO_ACTIVITY_SHIFT_SIDE_SECONDS=1
CAPSULE_VIDEO_KEYFRAME_SIZE=224
CAPSULE_VIDEO_KEYFRAME_JPEG_QUALITY=85
CAPSULE_VIDEO_MAX_REPRESENTATIVE_FRAMES=3
CAPSULE_MOBILECLIP_MODEL_PATH=data/models/mobileclip-s0/mobileclip_s0.pt
CAPSULE_MOBILECLIP_BATCH_SIZE=12
CAPSULE_MODEL_MAX_RETRIES=4
CAPSULE_UNDERSTANDING_TIMEOUT_SECONDS=180
CAPSULE_UNDERSTANDING_MAX_OUTPUT_TOKENS=2048
CAPSULE_SEARCH_PARSER_MAX_OUTPUT_TOKENS=500
CAPSULE_EMBEDDING_TIMEOUT_SECONDS=180
CAPSULE_MILVUS_BATCH_SIZE=100

# Merge near-duplicate HDBSCAN groups before generating Cluster Capsules.
# Density-tree branches within this normalized Euclidean distance are joined.
# 0.5 is approximately cosine similarity 0.875 after post-PCA L2 normalization.
CAPSULE_CLUSTER_SELECTION_EPSILON=0.5
CAPSULE_CLUSTER_SEMANTIC_MERGE_ENABLED=true
CAPSULE_CLUSTER_MERGE_CENTROID_COSINE_THRESHOLD=0.92
CAPSULE_CLUSTER_MERGE_CROSS_MEAN_COSINE_THRESHOLD=0.84
CAPSULE_CLUSTER_MERGE_MEMBER_MIN_COSINE_THRESHOLD=0.92
CAPSULE_CLUSTER_INCREMENTAL_ASSIGNMENT_THRESHOLD=0.92
CAPSULE_CLUSTER_RECLUSTER_RATIO_THRESHOLD=0.10
CAPSULE_CLUSTER_RECLUSTER_MINIMUM_COUNT=50
CAPSULE_CLUSTER_RECLUSTER_CONCURRENCY=1

CAPSULE_SEARCH_CHANNEL_TOP_K_MULTIPLIER=3
CAPSULE_SEARCH_CHANNEL_TOP_K_CAP=100
CAPSULE_SEARCH_CANDIDATE_CAP=300
CAPSULE_SEARCH_SAME_SOURCE_LIMIT=3
CAPSULE_SEARCH_CLUSTER_TOP_K=12
CAPSULE_SEARCH_RRF_K=60
CAPSULE_SEARCH_HNSW_EF=128
CAPSULE_SEARCH_ENGINE_VERSION=search-v1
CAPSULE_SEARCH_CAPSULE_RECENT_LIMIT=10
CAPSULE_QUERY_IMAGE_MAX_BYTES=20971520
CAPSULE_SEARCH_NATIVE_WEIGHT=1.0
CAPSULE_SEARCH_DESCRIPTION_WEIGHT=0.8
CAPSULE_SEARCH_SUBJECT_WEIGHT=0.8
CAPSULE_SEARCH_VISUAL_WEIGHT=0.6
CAPSULE_SEARCH_CORS_ORIGINS=["http://localhost:3000","https://capsule-search-workspace.ranhaoxu212.chatgpt.site"]
